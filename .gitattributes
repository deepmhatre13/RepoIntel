# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must always use LF line endings
*.sh text eol=lf

# Python scripts must always use LF line endings
*.py text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Configuration files
*.conf text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Other common text files
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
