# --- LLM (Gemini is the only provider) ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# --- Database ---
# Async SQLAlchemy URL. SQLite default; use postgresql+asyncpg:// for production.
DATABASE_URL=sqlite+aiosqlite:///./repointel.db

# --- Embeddings ---
# Provider: "local" uses sentence-transformers (no API key).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- Logging ---
LOG_LEVEL=INFO

# --- Resource budgets (Phase 42; see packages/runtime/resource_manager.py) ---
MAX_REPOSITORY_FILES=20000
MAX_FILE_SIZE=2097152
MAX_TOTAL_REPOSITORY_SIZE=524288000
MAX_PARSE_WORKERS=4
MAX_EMBEDDING_BATCH=64
MAX_GRAPH_NODES=100
MAX_GRAPH_EDGES=500
MAX_SEARCH_RESULTS=20
MAX_HISTORY_COMMITS=50
MAX_CONTEXT_TOKENS=8000
MAX_LLM_CALLS=25
MAX_EXECUTION_SECONDS=900

