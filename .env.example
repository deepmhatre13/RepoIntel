# --- LLM (Gemini is the only provider) ---
# NEVER commit real keys. Use .env (gitignored) for actual credentials.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Database ---
# RepoIntel's persistent backend is PostgreSQL + the `vector` (pgvector) extension.
# Async SQLAlchemy URL. For local development point this at a *native* PostgreSQL
# service that already has pgvector installed (no Docker required):
#
#   DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<dbname>
#
#   Example (local PostgreSQL running as the `repointel` role):
#   DATABASE_URL=postgresql+asyncpg://repointel:repointel_local_dev_password@localhost:5432/repointel
#
# SQLite (sqlite+aiosqlite:///./repointel.db) is ONLY a lightweight fallback for
# offline, unit-only, or reading-exercises. It is NOT the real persistence layer;
# production and the documented local workflow both use PostgreSQL + pgvector.
# Alembic migrations run against whatever DATABASE_URL points at:
#
#   python -m repointel.cli db-upgrade      # apply all pending migrations
#   python -m repointel.cli db-check        # full schema validation
DATABASE_URL=postgresql+asyncpg://repointel:repointel_local_dev_password@localhost:5432/repointel

# --- Redis / Celery ---
# The Celery worker and the API dispatch long-running work through a *real*
# external Redis broker. Point these at a native/local Redis installation
# (no Docker required). Docker Compose overrides these to its own service
# names in docker-compose.yml; do not change that file when running locally.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Celery worker ---
# Start the worker natively from the repository's Python environment:
#   python -m packages.worker.start_worker
# or with explicit broker/backend overrides:
#   CELERY_BROKER_URL=redis://localhost:6379/0 CELERY_RESULT_BACKEND=redis://localhost:6379/1 \
#     python -m packages.worker.start_worker
WORKER_CONCURRENCY=2

# --- Embeddings ---
# Provider: "local" uses sentence-transformers (no API key).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- Logging ---
LOG_LEVEL=INFO

# --- Resource budgets (Phase 42; see packages/runtime/resource_manager.py) ---
MAX_REPOSITORY_FILES=20000
MAX_FILE_SIZE=2097152
MAX_TOTAL_REPOSITORY_SIZE=524288000
MAX_PARSE_WORKERS=4
MAX_EMBEDDING_BATCH=64
MAX_GRAPH_NODES=100
MAX_GRAPH_EDGES=500
MAX_SEARCH_RESULTS=20
MAX_HISTORY_COMMITS=50
MAX_CONTEXT_TOKENS=8000
MAX_LLM_CALLS=25
MAX_EXECUTION_SECONDS=900

