# ---------------------------------------------------------------------------
# RepoIntel production environment (docker compose)
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- LLM (Gemini is the ONLY provider; optional) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Database (production uses PostgreSQL) ---
POSTGRES_USER=repointel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=repointel
# The API container derives DATABASE_URL from the compose template. You do NOT
# need to set it manually unless you run without compose.
# DATABASE_URL=postgresql+asyncpg://repointel:change-me@localhost:5432/repointel

# --- Embeddings ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- CORS ---
# Comma-separated list. When empty the API defaults to http://localhost:5173.
REPOINTEL_CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO

# --- API server ---
REPOINTEL_PORT=8000
REPOINTEL_WORKERS=2

# --- Resource budgets (see packages/runtime/resource_manager.py) ---
MAX_REPOSITORY_FILES=20000
MAX_FILE_SIZE=2097152
MAX_TOTAL_REPOSITORY_SIZE=524288000
MAX_PARSE_WORKERS=4
MAX_EMBEDDING_BATCH=64
MAX_GRAPH_NODES=100
MAX_GRAPH_EDGES=500
MAX_HISTORY_COMMITS=50
MAX_LLM_CALLS=25
MAX_EXECUTION_SECONDS=900